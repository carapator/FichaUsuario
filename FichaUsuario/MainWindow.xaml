<Window x:Class="FichaUsuario.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FichaUsuario"
        mc:Ignorable="d"
        Title="Ficha de usuario" Height="450" Width="500"
        ResizeMode="NoResize"
        Loaded="Window_Loaded">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nombre:" VerticalAlignment="Center" Margin="0,5" />
        <TextBox x:Name="txtNombre" Grid.Row="0" Grid.Column="1" MaxLength="60" Margin="10,5,0,5" />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Correo:" VerticalAlignment="Center" Margin="0,5" />
        <TextBox x:Name="txtCorreo" Grid.Row="1" Grid.Column="1" MaxLength="100" Margin="10,5,0,5" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Ciudad:" VerticalAlignment="Center" Margin="0,5" />
        <ComboBox x:Name="cmbCiudad" Grid.Row="2" Grid.Column="1"
                  DisplayMemberPath="Nombre" SelectedValuePath="Id"
                  IsEditable="False" Margin="10,5,0,5" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Fecha:" VerticalAlignment="Center" Margin="0,5" />
        <DatePicker x:Name="dpFecha" Grid.Row="3" Grid.Column="1" Margin="10,5,0,5" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="" VerticalAlignment="Center" Margin="0,5" />
        <CheckBox x:Name="chkCondiciones" Grid.Row="4" Grid.Column="1"
                  Content="Acepto condiciones" Margin="10,5,0,5"
                  Checked="chkCondiciones_Checked" Unchecked="chkCondiciones_Unchecked" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="" VerticalAlignment="Center" Margin="0,5" />
        <Button x:Name="btnGuardar" Grid.Row="5" Grid.Column="1" Content="Guardar"
                IsEnabled="False" IsDefault="True" Margin="10,15,0,5" Padding="20,5"
                HorizontalAlignment="Left" Click="btnGuardar_Click" />

        <TextBlock x:Name="txtResumen" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                   Margin="0,15,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>